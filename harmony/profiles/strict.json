{
  "name": "strict",
  "description": "A perfect fourth, fifth or octave reached by similar motion is a fault in every pair and at every compound - an eleventh is a fourth, a twelfth a fifth. Between inner voices a stepping upper part is excused and priced rather than forbidden. The leading tone resolves in the outer voices and may fall only to the fifth in an inner one; the German sixth excuses the unequal fifth it forces.",
  "ranges": {
    "soprano": [
      "C4",
      "G5"
    ],
    "alto": [
      "G3",
      "D5"
    ],
    "tenor": [
      "C3",
      "G4"
    ],
    "bass": [
      "E2",
      "C4"
    ]
  },
  "params": {
    "hidden_perfect_pairs": "all",
    "german_sixth_fifths": "forbid",
    "unequal_fifths": "all",
    "consecutive_perfects_pairs": "all",
    "hidden_perfect_leap": "excuse",
    "hidden_perfect_intervals": [
      4,
      5,
      8
    ],
    "parallel_intervals": [
      1,
      4,
      5,
      8
    ],
    "motion_voices": [
      "soprano"
    ],
    "parallel_fourths_with_bass_only": false,
    "leading_tone_outer_voices": [
      "soprano",
      "bass"
    ],
    "hidden_fourth_pairs": "all",
    "unequal_fourths": "all",
    "applied_leading_tone_voices": [
      "soprano",
      "bass"
    ],
    "hidden_fourth_leap": "none",
    "hidden_outer_leap": "none",
    "similar_motion_limit": 3
  },
  "rules": {
    "voice_range": {
      "enabled": true,
      "severity": "error",
      "cost": "inf"
    },
    "spacing": {
      "enabled": true,
      "severity": "error",
      "cost": "inf"
    },
    "voice_crossing": {
      "enabled": true,
      "severity": "error",
      "cost": "inf"
    },
    "doubled_tendency_tone": {
      "enabled": true,
      "severity": "warning",
      "cost": 14.0
    },
    "incomplete_chord": {
      "enabled": true,
      "severity": "warning",
      "cost": 7.0
    },
    "parallel_perfect": {
      "enabled": true,
      "severity": "error",
      "cost": "inf",
      "waived_cost": 40.0
    },
    "parallel_altered": {
      "enabled": true,
      "severity": "error",
      "cost": "inf"
    },
    "voice_overlap": {
      "enabled": true,
      "severity": "error",
      "cost": "inf"
    },
    "leading_tone_resolution": {
      "enabled": true,
      "severity": "error",
      "cost": "inf",
      "waived_cost": 25.0
    },
    "seventh_resolution": {
      "enabled": true,
      "severity": "error",
      "cost": "inf"
    },
    "melodic_augmented": {
      "enabled": true,
      "severity": "error",
      "cost": "inf"
    },
    "large_leap": {
      "enabled": true,
      "severity": "style",
      "cost": 1.5
    },
    "leap_recovery": {
      "enabled": true,
      "severity": "style",
      "cost": 2.0
    },
    "outer_voice_similar_motion": {
      "enabled": true,
      "severity": "style",
      "cost": 0.6
    },
    "similar_motion": {
      "enabled": true,
      "severity": "style",
      "cost": 6.0
    },
    "hidden_perfect": {
      "enabled": true,
      "severity": "error",
      "cost": "inf",
      "waived_cost": 40.0
    },
    "augmented_sixth_resolution": {
      "enabled": true,
      "severity": "error",
      "cost": "inf"
    },
    "unequal_fifths": {
      "enabled": true,
      "severity": "error",
      "cost": "inf",
      "waived_cost": 40.0
    },
    "unequal_fourths": {
      "enabled": true,
      "severity": "error",
      "cost": "inf",
      "waived_cost": 40.0
    },
    "missing_essential_tone": {
      "enabled": true,
      "severity": "error",
      "cost": "inf"
    },
    "voice_unison": {
      "enabled": true,
      "severity": "warning",
      "cost": 8.0
    },
    "consecutive_perfects": {
      "enabled": true,
      "severity": "error",
      "cost": "inf"
    },
    "doubled_leading_tone": {
      "enabled": true,
      "severity": "warning",
      "cost": 18.0
    },
    "doubling_preference": {
      "enabled": true,
      "severity": "style",
      "cost": 1.5
    },
    "missing_seventh": {
      "enabled": true,
      "severity": "warning",
      "cost": 9.0
    }
  }
}
